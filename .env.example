# PostgreSQL connection string (required)
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/kir-dev-hu

# Payload CMS secret (required - generate a long random string in production)
PAYLOAD_SECRET=local-development-secret

# Optional S3/Garage media storage (falls back to local ./media directory when unset)
S3_BUCKET=kir-dev-hu-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=

# Public site URL for metadata / canonical links
NEXT_PUBLIC_SITE_URL=https://kir-dev.hu

# Optional self-hosted Plausible analytics URL
NEXT_PUBLIC_PLAUSIBLE_URL=

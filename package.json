{
  "name": "kir-dev-blog-v3",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "payload generate:importmap && next build",
    "dev": "next dev",
    "format": "prettier --write . --ignore-path .gitignore",
    "lint": "next lint",
    "migrate": "payload migrate --yes",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "payload": "payload",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "types": "payload generate:types"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@payloadcms/db-postgres": "3.67.0",
    "@payloadcms/next": "3.67.0",
    "@payloadcms/richtext-lexical": "3.67.0",
    "@payloadcms/storage-s3": "3.67.0",
    "@payloadcms/translations": "3.67.0",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.5.2",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "graphql": "^16.8.1",
    "next": "15.5.9",
    "next-intl": "^4.0.2",
    "next-themes": "^0.4.6",
    "payload": "3.67.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "refractor": "^4.8.1",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.10",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.4.1"
